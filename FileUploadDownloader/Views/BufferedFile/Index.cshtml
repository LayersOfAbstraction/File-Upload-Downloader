@model IEnumerable<FileModel>
<!-- Get all the files from the server -->
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FileName)
            </th>
            <th>
                Download links
            </th>
            <th>
                View Image
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FileName)
                </td>
                <td>
                    <a asp-action="Download"
                       asp-route-filename="@Url.Content(item.FileName)">
                        Download File
                    </a>
                </td>
                <td>
                    <a asp-action="Details" asp-route-filePath="@item.FileExtension">@item.FileName</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<img src="~/Uploads/MyImage.png" class="img" alt="Test">